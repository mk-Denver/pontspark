# Required: Breez SDK API key (request one at https://breez.technology/request-api-key/)
EXPO_PUBLIC_BREEZ_API_KEY=
# mainnet (default) or regtest
EXPO_PUBLIC_BREEZ_NETWORK=mainnet
# Optional comma-separated default relays
EXPO_PUBLIC_DEFAULT_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
